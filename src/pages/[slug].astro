---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('pages', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.title} — Raghavendra Jadhav`} description={d.description}>
  <div class="wrap article">
    <header class="page-hero" style="padding-bottom:0">
      <a class="back-link" href="/"><span class="a">←</span> Home</a>
    </header>
    <div class="article-head">
      <h1 class="at">{d.title}</h1>
    </div>
    <article class="prose"><Content /></article>
  </div>
</Base>
