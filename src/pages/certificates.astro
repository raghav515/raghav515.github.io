---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const certs = (site.certifications ?? []).map((c, i) => ({
  i,
  name: c.name,
  meta: [c.issuer, c.date].filter(Boolean).join(' · '),
  url: c.url || '',
  pdf: c.pdf || '',
}));
---
<Base
  title="Certifications — Raghavendra Jadhav"
  description="My certifications: pick one to view the certificate and verify it with the issuer."
>
  <div class="wrap">
    <header class="page-hero">
      <a class="back-link" href="/#certifications"><span class="a">←</span> Back to profile</a>
      <span class="eyebrow kicker">Certifications</span>
      <h1>Verify it yourself</h1>
    </header>

    <section style="padding-top:0">
      {certs.length ? (
        <>
          <div class="cs-tabs" role="tablist" aria-label="Choose a certificate">
            {certs.map((c) => (
              <button
                type="button"
                role="tab"
                class="cs-tab"
                data-i={c.i}
                data-name={c.name}
                data-meta={c.meta}
                data-url={c.url}
                data-pdf={c.pdf}
              >{c.name}</button>
            ))}
          </div>

          <div class="cs-viewer">
            <div class="cs-bar">
              <div>
                <div class="cs-name" id="csName"></div>
                <div class="cs-meta" id="csMeta"></div>
              </div>
              <a class="btn primary" id="csVerify" target="_blank" rel="noopener" hidden>Verify <span class="arw">↗</span></a>
            </div>
            <div class="cs-stage" id="csStage">
              <div class="cs-pages" id="csPages" hidden></div>
              <div class="cs-msg" id="csMsg" hidden></div>
            </div>
          </div>
        </>
      ) : (
        <div class="empty">No certifications yet. Add one in <b>/admin</b> → Site → Profile &amp; Contact.</div>
      )}
    </section>
  </div>
</Base>

<style>
  .cs-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 6px;
    margin-bottom: 18px;
    scrollbar-width: none;
  }
  .cs-tabs::-webkit-scrollbar { display: none; }
  .cs-tab {
    flex: none;
    font-family: var(--ff-mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--ink-3);
    background: rgba(13, 21, 38, 0.4);
    border: 1px solid var(--steel-line);
    padding: 10px 16px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.25s var(--ease);
  }
  .cs-tab:hover { color: var(--ink); border-color: var(--blue-dim); }
  .cs-tab.active { background: var(--blue); border-color: var(--blue); color: #fff; }

  .cs-viewer {
    border: 1px solid var(--steel-line);
    background: linear-gradient(160deg, rgba(13, 21, 38, 0.9), rgba(7, 12, 22, 0.9));
  }
  .cs-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 16px 20px;
    border-bottom: 1px solid var(--steel);
  }
  .cs-name { font-family: var(--ff-serif); font-size: 19px; color: var(--ink); line-height: 1.3; }
  .cs-meta { font-family: var(--ff-mono); font-size: 11px; color: var(--ink-3); letter-spacing: 0.03em; margin-top: 4px; }

  .cs-stage {
    position: relative;
    height: min(76vh, 760px);
    min-height: 420px;
    overflow-x: hidden;
    overflow-y: auto;
    background: var(--panel);
  }
  .cs-pages { padding: 12px; }
  .cs-pages canvas {
    display: block;
    margin: 0 auto 12px;
    max-width: 100%;
    height: auto;
    background: #fff;
    box-shadow: 0 6px 24px -8px rgba(0, 0, 0, 0.6);
  }
  .cs-msg {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
    font-family: var(--ff-mono);
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .cs-msg a { color: var(--blue-bright); text-decoration: underline; }
</style>

<script>
  (function () {
    const tabs = Array.from(document.querySelectorAll('.cs-tab'));
    const pagesEl = document.getElementById('csPages');
    const msgEl = document.getElementById('csMsg');
    const stage = document.getElementById('csStage');
    const nameEl = document.getElementById('csName');
    const metaEl = document.getElementById('csMeta');
    const verifyEl = document.getElementById('csVerify');
    if (!tabs.length || !pagesEl || !msgEl || !stage || !nameEl || !metaEl || !verifyEl) return;

    const PDFJS = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/';
    let pdfLibPromise = null;
    function loadPdfLib() {
      if (pdfLibPromise) return pdfLibPromise;
      pdfLibPromise = new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = PDFJS + 'pdf.min.js';
        s.onload = () => {
          const lib = window.pdfjsLib;
          lib.GlobalWorkerOptions.workerSrc = PDFJS + 'pdf.worker.min.js';
          resolve(lib);
        };
        s.onerror = () => reject(new Error('pdf.js failed to load'));
        document.head.appendChild(s);
      });
      return pdfLibPromise;
    }

    let current = 0; // token so a stale render never overwrites a newer one
    let currentPdf = '';

    function showMsg(html) {
      pagesEl.hidden = true;
      msgEl.innerHTML = html;
      msgEl.hidden = false;
    }

    async function renderPdf(url, token) {
      showMsg('Loading certificate…');
      try {
        const lib = await loadPdfLib();
        const doc = await lib.getDocument(url).promise;
        if (token !== current) return;
        const frag = document.createDocumentFragment();
        const cssW = Math.max(200, stage.clientWidth - 40);
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const total = Math.min(doc.numPages, 10);
        for (let n = 1; n <= total; n++) {
          const page = await doc.getPage(n);
          if (token !== current) return;
          const base = page.getViewport({ scale: 1 });
          const scale = cssW / base.width;
          const vp = page.getViewport({ scale: scale * dpr });
          const canvas = document.createElement('canvas');
          canvas.width = Math.floor(vp.width);
          canvas.height = Math.floor(vp.height);
          canvas.style.width = cssW + 'px';
          await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
          if (token !== current) return;
          frag.appendChild(canvas);
        }
        pagesEl.replaceChildren(frag);
        pagesEl.hidden = false;
        msgEl.hidden = true;
        stage.scrollTop = 0;
      } catch (e) {
        if (token !== current) return;
        showMsg('Couldn\'t display this PDF. <a href="' + url + '" target="_blank" rel="noopener">Open it directly</a>.');
      }
    }

    function select(i, updateHash) {
      const tab = tabs[i];
      if (!tab) return;
      tabs.forEach((t) => {
        t.classList.toggle('active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      });
      const pdf = tab.dataset.pdf || '';
      const url = tab.dataset.url || '';
      nameEl.textContent = tab.dataset.name || '';
      metaEl.textContent = tab.dataset.meta || '';

      if (url) {
        verifyEl.href = url;
        verifyEl.hidden = false;
      } else {
        verifyEl.hidden = true;
      }

      current += 1;
      currentPdf = pdf;
      if (pdf) {
        renderPdf(pdf, current);
      } else {
        showMsg('The certificate PDF hasn\'t been added yet.');
      }

      tab.scrollIntoView({ block: 'nearest', inline: 'center' });
      if (updateHash) history.replaceState(null, '', '#' + i);
    }

    function fromHash() {
      const n = parseInt(location.hash.slice(1), 10);
      return Number.isInteger(n) && n >= 0 && n < tabs.length ? n : 0;
    }

    tabs.forEach((t, i) => t.addEventListener('click', () => select(i, true)));
    window.addEventListener('hashchange', () => select(fromHash(), false));

    let resizeTimer;
    let lastW = stage.clientWidth;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (currentPdf && Math.abs(stage.clientWidth - lastW) > 8) {
          lastW = stage.clientWidth;
          current += 1;
          renderPdf(currentPdf, current);
        }
      }, 250);
    });

    select(fromHash(), false);
  })();
</script>
